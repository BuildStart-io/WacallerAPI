# WacallerAPI Server Configuration
WACALLER_ADDR=:8090
WACALLER_DB=wacaller.db
WACALLER_API_KEY=your_personal_access_token_here

# PostgreSQL & Storage
POSTGRES_DSN=postgres://wacaller:wacaller@localhost:5432/wacaller?sslmode=disable
REDIS_URL=redis://localhost:6379/0
WACALLER_WA_DB=wacaller_wa.db

# Stripe Billing & Subscription API Keys
# Get your keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
# Stripe Webhook Secret (from https://dashboard.stripe.com/webhooks or Stripe CLI)
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
